{
    "$id": "https://schema.beyondallreason.dev/tachyon/definitions/currentVote.json",
    "title": "CurrentVote",
    "description": "The current vote in progress, if any",
    "anyOf": [
        {
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "action": { "$ref": "../definitions/voteActions.json" },
                "initiator": { "$ref": "../definitions/userId.json" },
                "voters": {
                    "description": "indexed by the userId. The initiator is also included in this object",
                    "type": "object",
                    "patternProperties": {
                        "^.*$": {
                            "anyOf": [
                                {
                                    "type": "object",
                                    "properties": {
                                        "vote": {
                                            "enum": [
                                                "pending",
                                                "yes",
                                                "no",
                                                "abstain"
                                            ]
                                        }
                                    },
                                    "required": ["vote"]
                                },
                                { "type": "null" }
                            ]
                        }
                    }
                },
                "until": { "$ref": "../definitions/unixTime.json" },
                "quorum": {
                    "description": "this many player must vote for the vote to be valid at all",
                    "type": "integer",
                    "minimum": 1
                },
                "majority": {
                    "description": "percentage of yes votes out of non abstaining votes required for the vote to pass",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "required": [
                "id",
                "action",
                "initiator",
                "voters",
                "until",
                "quorum",
                "majority"
            ]
        },
        { "type": "null" }
    ]
}
