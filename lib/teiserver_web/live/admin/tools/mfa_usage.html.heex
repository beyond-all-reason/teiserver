<ToolsComponents.section_menu
  active="mfa_usage"
  scope={@scope}
/>

<.header>
  MFA Usage
  <:subtitle>
    Subtitle text
  </:subtitle>
</.header>
<div class="heading-subtitle">{@user_count} users found</div>

<.simple_form
  :if={@connected?}
  for={@form}
  id="time_compare-form"
  phx-change="update"
  phx-submit="update"
>
  <div class="flex my-2">
    <div class="flex-1 m-2">
      <.input_tw field={@form[:login_after]} type="date" label="Logged in after" />
    </div>

    <div class="flex-2 m-2">
      <.input_tw
        field={@form[:role]}
        type="text"
        label="With a specific MFA role"
        placeholder={Enum.join(@default_role_list, ", ")}
      />
    </div>

    <div class="flex-1 m-2">
      <.input_tw
        type="select"
        field={@form[:order_by]}
        label="Order by"
        options={[
          "Most recent login first",
          "Oldest login first",
          "Alphabetical (A-Z)",
          "Alphabetical (Z-A)"
        ]}
      />
    </div>
  </div>
</.simple_form>

<div :if={@connected? and @user_count == 0} class="alert alert-info mt-20" id="no-results-alert">
  No users found
</div>

<div class="flex">
  <div class="flex-1">
    <.table
      :if={@connected?}
      id="users-table"
      rows={@streams.users}
      table_class="table-sm table-zebra mt-4"
      row_click={fn {_id, user} -> JS.navigate(~p"/moderation/users/#{user.id}") end}
    >
      <:col :let={{_id, user}} label="Name">{user.name}</:col>
      <:col :let={{_id, user}} label="Last login">
        {date_to_str(user.last_login, format: :hms_or_ymd)}
      </:col>
      <:col :let={{_id, user}} label="Roles">{Enum.join(user.roles, ", ")}</:col>
      <:col :let={{_id, user}} label="">
        <a
          href={~p"/teiserver/admin/user/#{user.id}"}
          class="btn btn-secondary btn-outline btn-xs"
        >
          Show
        </a>
      </:col>
    </.table>
  </div>
</div>

<.back navigate={~p"/admin"}>Back to Admin</.back>
