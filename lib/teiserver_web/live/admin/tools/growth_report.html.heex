<ToolsComponents.section_menu
  active="growth_report"
  scope={@scope}
/>

<.header>
  Growth report
</.header>
<div class="mx-auto max-w-[1080px] flex flex-col">
  <.simple_form
    :if={@connected?}
    for={@render_form}
    id="render_form"
    phx-change="update_render"
  >
    <div class="flex-col flex my-2">
      <div class="md:flex-row flex-col flex">
        <div class="flex-1 m-2">
          <.input_tw
            field={@render_form[:columns]}
            type="select"
            label="Columns:"
            options={@cols_options}
          />
        </div>

        <div class="flex-1 m-2">
          <.input_tw
            field={@render_form[:chart_type]}
            type="select"
            options={@chart_types}
            label="Chart type:"
          />
        </div>
      </div>
    </div>
  </.simple_form>

  <.simple_form
    :if={@connected?}
    for={@data_form}
    id="data_form"
    phx-change="update_data"
  >
    <div class="flex-col flex my-2">
      <div class="md:flex-row flex-col flex">
        <div class="flex-1 m-2">
          <.input_tw
            field={@data_form[:time_unit]}
            type="select"
            label="Time unit:"
            options={@time_units}
          />
        </div>
        <div class="flex-1 m-2">
          <.input_tw
            field={@data_form[:log_count]}
            type="text"
            inputmode="numeric"
            label="Log count:"
          />
        </div>
      </div>
      <div class="flex-1 m-2 self-center">
        <%= if @data_form.source.valid? do %>
          <.button type="button" phx-click="fetch">
            UPDATE
          </.button>
        <% else %>
          <.button type="button" disabled={true}>
            UPDATE
          </.button>
        <% end %>
      </div>
    </div>
  </.simple_form>
</div>
<div class={"grid mt-20 max-w-[80%] #{calc_cols(@render_form)} gap-4 mx-auto"}>
  <%= if @connected? do %>
    <%= Enum.map(@chart_series, fn %{title: title, series: series} -> %>
      <%= case LiveChartsHelper.generate_multi_series_maps_chart(series, @date_keys, LiveChartsHelper.get_atom(@render_form[:chart_type].value), title) do %>
        <% {:ok, chart} -> %>
          <div
            id={"apexcharts-container #{title}"}
            class="apexchart-container"
            phx-hook="ApexChartsGridResize"
          >
            <LiveCharts.chart chart={chart} />
          </div>
        <% {:error, reason} -> %>
          <div>{reason}</div>
      <% end %>
    <% end) %>
  <% end %>
</div>
<.back navigate={~p"/admin"}>Back to Admin</.back>
