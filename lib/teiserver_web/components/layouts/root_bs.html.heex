<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <%= if assigns[:rss_feed] do %>
      <link rel="alternate" type="application/rss+xml" title="Blog title" href={@rss_feed} />
    <% end %>

    <.live_title suffix={Application.get_env(:teiserver, Teiserver)[:site_suffix]}>
      {assigns[:page_title] || Application.get_env(:teiserver, Teiserver)[:site_title]}
    </.live_title>

    <% light_mode =
      case Teiserver.Config.get_user_config_cache(@current_user, "general.Colour scheme") do
        "Site default" -> Teiserver.Config.get_site_config_cache("user.Default light mode")
        "Light" -> true
        "Dark" -> false
        _ -> Teiserver.Config.get_site_config_cache("user.Default light mode")
      end %>

    <%= if light_mode do %>
      <link phx-track-static rel="stylesheet" href={~p"/assets/light_bs.css"} />
    <% else %>
      <link phx-track-static rel="stylesheet" href={~p"/assets/dark_bs.css"} />
    <% end %>
    <link phx-track-static rel="stylesheet" href={~p"/css/fontawesome.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/css/solid.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/css/regular.css"} />
    <link phx-track-static rel="stylesheet" href={~p"/css/brands.css"} />

    <script>
      window.userToken = "<%= assigns[:user_token] %>";
    </script>

    <script phx-track-static type="text/javascript" src={~p"/js/jquery.min.js"}>
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/js/bootstrap.min.js"}>
    </script>
  </head>
  <body class="container-fluid px-0 d-flex flex-column">
    <div
      :if={assigns[:real_user] && assigns[:current_user]}
      id="view-as-banner"
      class="view-as-banner"
    >
      <style>
        .view-as-banner {
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          z-index: 1100;
          background: #b45309;
          color: #fff;
          padding: 8px 12px;
          text-align: center;
          box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.4);
        }
        body {
          padding-bottom: 52px;
        }
        .view-as-stop {
          margin-left: 12px;
          padding: 4px 14px;
          background: #fff;
          color: #92400e;
          border: 2px solid #fff;
          border-radius: 6px;
          font-weight: 700;
          cursor: pointer;
          transition: background 0.15s, color 0.15s, transform 0.15s, box-shadow 0.15s;
        }
        .view-as-stop:hover,
        .view-as-stop:focus-visible {
          background: #92400e;
          color: #fff;
          transform: translateY(-1px);
          box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
        }
        .view-as-stop:active {
          transform: translateY(0);
          box-shadow: none;
        }
      </style>
      Viewing as <strong>{@current_user.name}</strong>
      (logged in as {@real_user.name}).
      <.form :let={_f} for={%{}} action={~p"/view_as"} method="delete" style="display:inline">
        <button type="submit" class="view-as-stop">
          ✕ Stop viewing as
        </button>
      </.form>
    </div>
    {@inner_content}
  </body>
</html>
