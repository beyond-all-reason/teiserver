<% bsname = view_colour() %>
<div class="row">
  <div class="col-md-12">
    <div class={"card border-#{bsname}"}>
      <div class="card-body">
        <TeiserverWeb.Components.Admin.UserComponents.section_menu
          active="edit"
          colour={bsname}
          current_user={@current_user}
        />

        <hr />

        {render("form.html", Map.put(assigns, :action, ~p"/teiserver/admin/user/#{@user}"))}
      </div>
    </div>
  </div>
</div>
