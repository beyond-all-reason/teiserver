<% bsname = view_colour() %>

<div class="row section-menu">
  <div class="col-md-12">
    <div class={"card border-#{bsname}"}>
      <div class="card-body">
        <TeiserverWeb.Components.Admin.CodeComponents.section_menu active="new" colour={bsname} />
        <hr />

        {render("form.html",
          changeset: @changeset,
          code_types: @code_types,
          conn: @conn,
          action: ~p"/teiserver/admin/codes"
        )}
      </div>
    </div>
  </div>
</div>
