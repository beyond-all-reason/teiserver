<% bsname = view_colour() %>

<div class="row section-menu">
  <div class="col-md-12">
    <div class={"card border-#{bsname}"}>
      <div class="card-body">
        <TeiserverWeb.Components.Admin.DiscordChannelComponents.section_menu
          active="edit"
          colour={bsname}
        />

        <hr />

        {render(
          "form.html",
          Map.put(assigns, :action, ~p"/admin/discord_channels/#{@discord_channel}")
        )}

        <hr />
        {link(raw("<i class='far fa-fw fa-trash'></i> Delete"),
          to: ~p"/admin/discord_channels/#{@discord_channel}",
          method: "delete",
          data: [confirm: "Are you sure?"],
          class: "btn btn-danger btn-outline"
        )}
      </div>
    </div>
  </div>
</div>
