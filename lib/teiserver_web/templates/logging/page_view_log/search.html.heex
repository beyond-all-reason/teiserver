<% {_fg, _bg, bsname} = view_colour() |> colours() %>
{central_component("picker_script",
  module: Teiserver.Account.UserLib,
  name: "account_user",
  title: "User search"
)}

<script type="text/javascript" charset="utf-8">
  $(function() {
    <%= if @show_search == true do %>
      show_search();
    <% end %>
  });
</script>

<div class="row">
  <div class="col-md-12">
    <div class={"card border-#{bsname} page-card"}>
      <div class="card-body">
        <div class={"btn btn-outline-#{bsname}"} onclick="show_search();" id="search-box-shower">
          <i class="fa-solid fa-fw fa-search"></i> Show search form
        </div>

        <form
          action={~p"/logging/page_views/search"}
          method="post"
          class="form-horizontal"
          id="search-box"
          style="display: none;"
        >
          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

          <div class="row">
            <div class="col-md-4 col-xl-2 search-form-input">
              <label for="teiserver-user-search" class="control-label">User: </label>
              {render(TeiserverWeb.Account.UserView, "picker.html",
                input_name: "search[account_user]",
                value: @params["account_user"]
              )}
            </div>

            <div class="col-md-4 col-xl-2 search-form-input">
              <label for="search_path" class="control-label">Path: </label>
              <input
                type="text"
                name="search[path]"
                id="search_path"
                value={@params["path"]}
                class="form-control"
              />
            </div>

            <div class="col-md-4 col-xl-2 search-form-input">
              <.input
                type="select"
                id="search_section"
                name="search[section]"
                label="Section"
                value={@params["section"]}
                options={[
                  {"Any section", "any"},
                  {"Admin", "admin"}
                ]}
              />
            </div>

            <div class="col-md-4 col-xl-2 search-form-input">
              <.input
                type="select"
                id="search_limit"
                name="search[limit]"
                label="Limit"
                value={@params["limit"]}
                options={[
                  "50",
                  "100",
                  "200"
                ]}
              />
            </div>

            <div class="col-md-4 col-xl-2 search-form-input">
              <label for="start_date" class="control-label">From: </label>
              <input
                type="text"
                id="start_date"
                name="search[start_date]"
                value={@params["start_date"]}
                class="form-control datepicker"
              />
            </div>

            <div class="col-md-4 col-xl-2 search-form-input">
              <label for="end_date" class="control-label">Until: </label>
              <input
                type="text"
                id="end_date"
                name="search[end_date]"
                value={@params["end_date"]}
                class="form-control datepicker"
              />
            </div>

            <div class="col-md-4 col-xl-2 search-form-input">
              <.input
                type="select"
                id="search_order"
                name="search[order]"
                label="Order by"
                value={@params["order"]}
                options={[
                  "Newest first",
                  "Oldest first",
                  "Slowest"
                ]}
              />
            </div>
          </div>

          <div class="row">
            <div class="offset-md-8 col-md-4 offset-xl-10 col-xl-2">
              &nbsp;<br />
              <input
                type="submit"
                value="Search"
                name="form.submitted"
                class={"btn btn-#{bsname} btn-block"}
              />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
