<% bsname = view_colour() %>

<%= form_for @response_changeset, @action, fn f -> %>
  <%= if @response_changeset.action do %>
    <div class="alert alert-danger">
      <p>Oops, something went wrong! Please check the errors below.</p>
    </div>
  <% end %>

  <div class="row mt-2">
    <%= for {action, icon} <- Teiserver.Moderation.ResponseLib.list_actions() do %>
      <div class="col">
        <label for={"response_#{action}"}><i class={"fa-fw #{icon}"}></i> {action}</label>
        <.input
          type="radio"
          class="form-check-input d-inline-block"
          name="response[action]"
          id={"response_#{action}"}
          value={action}
          field={f[:action]}
        />
      </div>
    <% end %>
  </div>

  <div class="row mt-2">
    <div class="col">
      <label for="response_is_accurate"><i class="fa-fw fa-check"></i> Accurate report</label>
      <.input
        type="radio"
        class="form-check-input d-inline-block"
        name="response[accurate]"
        id="response_is_accurate"
        value="true"
        field={f[:accurate]}
      />
    </div>

    <div class="col">
      <label for="response_not_accurate"><i class="fa-fw fa-times"></i> Inaccurate report</label>
      <.input
        type="radio"
        class="form-check-input d-inline-block"
        name="response[accurate]"
        id="response_not_accurate"
        value="false"
        field={f[:accurate]}
      />
    </div>
  </div>

  <div class="row my-3">
    <div class="col">
      <%= if @response_changeset.data.user_id do %>
        <input
          type="submit"
          value="Save changes"
          name="form.submitted"
          class={"btn btn-#{bsname} float-end"}
        />
      <% else %>
        <input
          type="submit"
          value="Create response"
          name="form.submitted"
          class={"btn btn-#{bsname} float-end"}
        />
      <% end %>
    </div>
  </div>
<% end %>
